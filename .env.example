# Core demo settings
DATABASE_URL=sqlite:///./var/audience_ops.db
LLM_PROVIDER=mock
OPENAI_MODEL=gpt-5.5
APPROVAL_THRESHOLD=5000
SYNTHETIC_STUDENT_COUNT=12000

# Real marketing sync is intentionally disabled by default.
ALLOW_REAL_MARKETING_SYNC=false
REAL_SYNC_MAX_RECIPIENTS=500

# Optional OpenAI mode (never commit real secrets)
OPENAI_API_KEY=

# Optional LearnDash adapter
LEARNDASH_BASE_URL=https://example.com
LEARNDASH_USERNAME=
LEARNDASH_APP_PASSWORD=

# Optional Mailchimp adapter
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=usX
MAILCHIMP_LIST_ID=

# Optional Constant Contact adapter
CONSTANT_CONTACT_ACCESS_TOKEN=
CONSTANT_CONTACT_LIST_ID=
CONSTANT_CONTACT_ACTIVITY_TIMEOUT_SECONDS=60
